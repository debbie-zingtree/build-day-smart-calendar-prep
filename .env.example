# .env.example — copy to .env and fill in real values.
#
# DO NOT put real secrets in this file. It is committed to version control and
# documents WHICH variables are needed, with placeholder values only.
# Your real .env must be gitignored and never committed.

# --- App ---
NODE_ENV=development

# --- Anthropic (SERVER-SIDE ONLY — never expose to the client) ---
# Get one: console.anthropic.com -> API Keys -> Create
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
